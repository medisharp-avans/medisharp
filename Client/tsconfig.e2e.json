{
  "extends": "./tsconfig.app.json",

  // Node scripts for Lighthouse/axe. They import the Vue router, so they reuse
  // the app config (path aliases, .vue types) with Node types instead of DOM.
  "include": ["e2e/**/*.ts", "env.d.ts"],
  "exclude": [],

  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
  }
}
